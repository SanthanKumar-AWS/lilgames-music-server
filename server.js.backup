require("dotenv").config();

const express = require("express");
const http = require("http");
const WebSocket = require("ws");
const path = require("path");

const app = express();
const server = http.createServer(app);

const PORT = process.env.PORT || 3000;

app.use(express.json());
const axios = require("axios");

const AUDIUS_API = "https://api.audius.co";
app.use(express.static(path.join(__dirname, "public")));
app.get("/api/search", async (req, res) => {

    try {

        const query =
            String(req.query.q || "").trim();

        if (!query) {
            return res.status(400).json({
                error: "Search query required."
            });
        }

        const response = await axios.get(
            `${AUDIUS_API}/v1/tracks/search`,
            {
                params: {
                    query,
                    limit: 10
                }
            }
        );

        const tracks =
            (response.data.data || []).map(track => ({
                id: track.id,
                title: track.title,
                artist:
                    track.user?.name ||
                    track.user?.handle ||
                    "Unknown Artist",
                duration: track.duration,
                artwork:
                    track.artwork?.["150x150"] ||
                    track.artwork?.["480x480"] ||
                    null
            }));

        res.json({
            results: tracks
        });

    } catch (error) {

        console.error(
            "Audius search error:",
            error.message
        );

        res.status(500).json({
            error: "Unable to search music."
        });

    }

});

/*
=========================================
AUDIUS STREAM PROXY
=========================================
*/

app.get("/api/stream/:trackId", async (req, res) => {

    try {

        const trackId =
            String(req.params.trackId || "").trim();

        if (!trackId) {

            return res.status(400).json({
                error: "Track ID required."
            });

        }

        const headers = {};

        /*
         * Forward Range header from the browser.
         * HTML5 audio commonly requires this.
         */

        if (req.headers.range) {
            headers.Range = req.headers.range;
        }

        const response =
            await axios.get(
                `${AUDIUS_API}/v1/tracks/${encodeURIComponent(trackId)}/stream`,
                {
                    headers,
                    responseType: "stream",
                    maxRedirects: 5,
                    validateStatus: status =>
                        status >= 200 && status < 400
                }
            );

        /*
         * Preserve Audius response status.
         */

        res.status(response.status);

        /*
         * Forward important audio headers.
         */

        const headersToForward = [
            "content-type",
            "content-length",
            "content-range",
            "accept-ranges"
        ];

        headersToForward.forEach(name => {

            if (response.headers[name]) {

                res.setHeader(
                    name,
                    response.headers[name]
                );

            }

        });

        /*
         * Make the response cache-friendly enough
         * for normal browser audio playback.
         */

        res.setHeader(
            "Cache-Control",
            "no-cache"
        );

        response.data.on(
            "error",
            error => {

                console.error(
                    "Audius stream pipe error:",
                    error.message
                );

                if (!res.headersSent) {
                    res.status(500);
                }

                res.end();

            }
        );

        response.data.pipe(res);

    } catch (error) {

        console.error(
            "Audius stream error:",
            error.message
        );

        if (!res.headersSent) {

            res.status(500).json({
                error: "Unable to stream music."
            });

        } else {

            res.end();

        }

    }

});

        }

        const response =
            await axios.get(
                `${AUDIUS_API}/v1/tracks/${encodeURIComponent(trackId)}/stream`,
                {
                    responseType: "stream",
                    maxRedirects: 5
                }
            );

        if (response.headers["content-type"]) {

            res.setHeader(
                "Content-Type",
                response.headers["content-type"]
            );

        }

        if (response.headers["content-length"]) {

            res.setHeader(
                "Content-Length",
                response.headers["content-length"]
            );

        }

        response.data.pipe(res);

    } catch (error) {

        console.error(
            "Audius stream error:",
            error.message
        );

        if (!res.headersSent) {

            res.status(500).json({
                error: "Unable to stream music."
            });

        } else {

            res.end();

        }

    }

});

app.get("/health", (req, res) => {
    res.json({
        status: "ok",
        service: "lilgames-music"
    });
});

/*
=========================================
MUSIC ROOMS
=========================================
*/

const musicRooms = new Map();

function generateRoomCode() {

    const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

    let code;

    do {

        code = "";

        for (let i = 0; i < 6; i++) {
            code += chars[Math.floor(Math.random() * chars.length)];
        }

    } while (musicRooms.has(code));

    return code;
}

function send(ws, data) {

    if (ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify(data));
    }

}

function broadcastRoom(roomCode, data) {

    const room = musicRooms.get(roomCode);

    if (!room) {
        return;
    }

    room.users.forEach(user => {
        send(user.ws, data);
    });

}

function getRoomUsers(room) {

    return Array.from(room.users.values()).map(user => ({
        id: user.id,
        username: user.username,
        organizer: user.organizer
    }));

}

/*
=========================================
WEBSOCKET
=========================================
*/

const wss = new WebSocket.Server({
    server,
    path: "/music-ws/"
});

wss.on("connection", (ws) => {

    console.log("Music client connected");

    ws.id =
        `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;

    ws.roomCode = null;
    ws.username = null;

    send(ws, {
        type: "connected"
    });

    ws.on("message", (raw) => {

        let data;

        try {

            data = JSON.parse(raw.toString());

        } catch (error) {

            send(ws, {
                type: "error",
                message: "Invalid request."
            });

            return;
        }

        /*
        =================================
        CREATE ROOM
        =================================
        */

        if (data.type === "create_room") {

            if (ws.roomCode) {

                send(ws, {
                    type: "error",
                    message: "You are already in a room."
                });

                return;
            }

            const username =
                String(data.username || "").trim();

            if (!username) {

                send(ws, {
                    type: "error",
                    message: "Enter your username."
                });

                return;
            }

            const roomCode = generateRoomCode();

            const room = {
                code: roomCode,
                organizerId: ws.id,
                users: new Map(),
                queue: [],
                currentSong: null,
                playing: false,
                position: 0,
                startedAt: null,
                waitingForReady: false,
                readyUsers: new Set(),
                audioEnabledUsers: new Set()
            };

            room.users.set(ws.id, {
                id: ws.id,
                ws,
                username,
                organizer: true
            });

            musicRooms.set(roomCode, room);

            ws.roomCode = roomCode;
            ws.username = username;

            send(ws, {
                type: "room_created",
                roomCode,
                username,
                organizer: true,
                users: getRoomUsers(room)
            });

            console.log(
                `Music room created: ${roomCode} by ${username}`
            );

            return;
        }

        /*
        =================================
        JOIN ROOM
        =================================
        */

        if (data.type === "join_room") {

            if (ws.roomCode) {

                send(ws, {
                    type: "error",
                    message: "You are already in a room."
                });

                return;
            }

            const username =
                String(data.username || "").trim();

            const roomCode =
                String(data.roomCode || "")
                    .trim()
                    .toUpperCase();

            if (!username) {

                send(ws, {
                    type: "error",
                    message: "Enter your username."
                });

                return;
            }

            if (!roomCode) {

                send(ws, {
                    type: "error",
                    message: "Enter a room code."
                });

                return;
            }

            const room = musicRooms.get(roomCode);

            if (!room) {

                send(ws, {
                    type: "error",
                    message: "Room not found."
                });

                return;
            }

            room.users.set(ws.id, {
                id: ws.id,
                ws,
                username,
                organizer: false
            });

            ws.roomCode = roomCode;
            ws.username = username;

            send(ws, {
                type: "room_joined",
                roomCode,
                username,
                organizer: false,
                users: getRoomUsers(room),
                queue: room.queue,
                currentSong: room.currentSong,
                playing: room.playing,
                position: room.position,
                startedAt: room.startedAt
            });

            broadcastRoom(roomCode, {
                type: "users_updated",
                users: getRoomUsers(room)
            });

            console.log(
                `${username} joined music room ${roomCode}`
            );

            return;
        }


        /*
        =================================
        ADD MUSIC TO QUEUE
        =================================
        */

        if (data.type === "add_to_queue") {

            if (!ws.roomCode) {

                send(ws, {
                    type: "error",
                    message: "You are not in a room."
                });

                return;
            }

            const room = musicRooms.get(ws.roomCode);

            if (!room) {
                return;
            }

            const trackId =
                String(data.trackId || "").trim();

            const title =
                String(data.title || "").trim();

            const artist =
                String(data.artist || "").trim();

            const artwork =
                String(data.artwork || "").trim();

            const duration =
                Number(data.duration || 0);

            if (!trackId) {

                send(ws, {
                    type: "error",
                    message: "Invalid music track."
                });

                return;
            }

            const track = {
                id: trackId,
                title,
                artist,
                artwork,
                duration
            };

            room.queue.push(track);

            broadcastRoom(ws.roomCode, {
                type: "queue_updated",
                queue: room.queue
            });

            return;
        }



        /*
        =================================
        PLAY TRACK DIRECTLY - DJ ONLY
        =================================
        */

        if (data.type === "play_track") {

            if (!ws.roomCode) {
                return;
            }

            const room = musicRooms.get(ws.roomCode);

            if (!room) {
                return;
            }

            if (room.organizerId !== ws.id) {

                send(ws, {
                    type: "error",
                    message: "Only the DJ can start music."
                });

                return;
            }

            const trackId =
                String(data.trackId || "").trim();

            if (!trackId) {

                send(ws, {
                    type: "error",
                    message: "Invalid music track."
                });

                return;
            }

            const track = {
                id: trackId,
                title: String(data.title || "").trim(),
                artist: String(data.artist || "").trim(),
                artwork: String(data.artwork || "").trim(),
                duration: Number(data.duration || 0)
            };

            room.currentSong = track;

            /*
             * Start from the beginning.
             */
            room.position = 0;

            /*
             * Music starts automatically.
             */
            room.playing = true;

            /*
             * Give every browser 2 seconds to receive
             * the message and load the stream.
             */
            room.startedAt = Date.now() + 2000;

            room.waitingForReady = false;

            if (room.readyUsers) {
                room.readyUsers.clear();
            }

            /*
             * Keep the selected track at the front.
             */
            room.queue =
                room.queue.filter(
                    item => String(item.id) !== trackId
                );

            room.queue.unshift(track);

            broadcastRoom(ws.roomCode, {
                type: "queue_updated",
                queue: room.queue
            });

            /*
             * Send the actual synchronized playback state.
             */
            broadcastRoom(ws.roomCode, {
                type: "music_state",
                currentSong: room.currentSong,
                playing: true,
                position: 0,
                startedAt: room.startedAt
            });

            console.log(
                `DJ starting "${track.title}" in music room ${ws.roomCode} at ${room.startedAt}`
            );

            return;
        }

        /*
        =================================
        AUDIO ENABLED
        =================================
        */

        if (data.type === "audio_enabled") {

            if (!ws.roomCode) {
                return;
            }

            const room = musicRooms.get(ws.roomCode);

            if (!room) {
                return;
            }

            room.audioEnabledUsers.add(ws.id);

            send(ws, {
                type: "audio_enabled_ack"
            });

            return;
        }


        /*
        =================================
        MUSIC READY
        =================================
        */

        if (data.type === "music_ready") {

            /*
             * Compatibility only.
             *
             * Playback is controlled by the DJ's
             * music_state message.
             */

            return;
        }

        /*
        =================================
        PLAY MUSIC - DJ ONLY
        =================================
        */

        if (data.type === "play_music") {

            if (!ws.roomCode) {
                return;
            }

            const room = musicRooms.get(ws.roomCode);

            if (!room || !room.currentSong) {
                return;
            }

            if (room.organizerId !== ws.id) {

                send(ws, {
                    type: "error",
                    message: "Only the DJ can control playback."
                });

                return;
            }

            const position =
                typeof data.position === "number"
                    ? Math.max(0, data.position)
                    : room.position;

            room.position = position;

            /*
             * Start slightly in the future so every browser
             * has time to receive the stream and synchronize.
             */

            const START_DELAY = 2000;

            room.startedAt =
                Date.now() +
                START_DELAY -
                (position * 1000);

            room.playing = true;
            room.waitingForReady = false;

            broadcastRoom(ws.roomCode, {
                type: "music_state",
                currentSong: room.currentSong,
                playing: true,
                position: room.position,
                startedAt: room.startedAt
            });

            return;
        }


        /*
        =================================
        PAUSE MUSIC - DJ ONLY
        =================================
        */

        if (data.type === "pause_music") {

            if (!ws.roomCode) {
                return;
            }

            const room = musicRooms.get(ws.roomCode);

            if (!room) {
                return;
            }

            if (room.organizerId !== ws.id) {

                send(ws, {
                    type: "error",
                    message: "Only the DJ can control playback."
                });

                return;
            }

            let position = room.position;

            if (room.playing && room.startedAt) {

                position =
                    Math.max(
                        0,
                        (Date.now() - room.startedAt) / 1000
                    );
            }

            if (typeof data.position === "number") {
                position = Math.max(0, data.position);
            }

            room.position = position;
            room.playing = false;
            room.startedAt = null;
            room.waitingForReady = false;

            broadcastRoom(ws.roomCode, {
                type: "music_state",
                currentSong: room.currentSong,
                playing: false,
                position: room.position,
                startedAt: null
            });

            return;
        }


        /*
        =================================
        SKIP MUSIC - DJ ONLY
        =================================
        */

        if (data.type === "skip_music") {

            if (!ws.roomCode) {
                return;
            }

            const room = musicRooms.get(ws.roomCode);

            if (!room) {
                return;
            }

            if (room.organizerId !== ws.id) {

                send(ws, {
                    type: "error",
                    message: "Only the DJ can control playback."
                });

                return;
            }

            if (room.queue.length > 0) {
                room.queue.shift();
            }

            room.currentSong =
                room.queue.length > 0
                    ? room.queue[0]
                    : null;

            room.position = 0;
            room.playing = false;
            room.startedAt = null;
            room.waitingForReady = false;
            room.readyUsers = new Set();

            broadcastRoom(ws.roomCode, {
                type: "queue_updated",
                queue: room.queue
            });

            if (room.currentSong) {

                room.waitingForReady = true;

                broadcastRoom(ws.roomCode, {
                    type: "prepare_music",
                    currentSong: room.currentSong,
                    position: 0
                });

            } else {

                broadcastRoom(ws.roomCode, {
                    type: "music_state",
                    currentSong: null,
                    playing: false,
                    position: 0,
                    startedAt: null
                });

            }

            return;
        }


        /*
        =================================
        LEAVE ROOM
        =================================
        */

        if (data.type === "leave_room") {

            leaveRoom(ws);

            return;
        }

        /*
        =================================
        UNKNOWN REQUEST
        =================================
        */

        send(ws, {
            type: "error",
            message: "Unknown request."
        });

    });

    ws.on("close", () => {

        leaveRoom(ws);

        console.log("Music client disconnected");

    });

    ws.on("error", (error) => {

        console.error(
            "Music WebSocket error:",
            error.message
        );

    });

});

/*
=========================================
LEAVE ROOM FUNCTION
=========================================
*/

function leaveRoom(ws) {

    if (!ws.roomCode) {
        return;
    }

    const roomCode = ws.roomCode;

    const room = musicRooms.get(roomCode);

    if (!room) {

        ws.roomCode = null;
        return;

    }

    room.users.delete(ws.id);

    if (room.readyUsers) {
        room.readyUsers.delete(ws.id);
    }

    if (room.audioEnabledUsers) {
        room.audioEnabledUsers.delete(ws.id);
    }

    ws.roomCode = null;

    /*
    If organizer leaves, make another
    user the new organizer.
    */

    if (room.organizerId === ws.id) {

        const nextUser =
            room.users.values().next().value;

        if (nextUser) {

            room.organizerId = nextUser.id;

            nextUser.organizer = true;

            send(nextUser.ws, {
                type: "organizer_changed"
            });

        }

    }

    /*
    Delete empty room.
    */

    if (room.users.size === 0) {

        musicRooms.delete(roomCode);

        console.log(
            `Music room deleted: ${roomCode}`
        );

        return;
    }

    broadcastRoom(roomCode, {
        type: "users_updated",
        users: getRoomUsers(room)
    });

}

/*
=========================================
START SERVER
=========================================
*/

server.listen(PORT, "0.0.0.0", () => {

    console.log(
        `LilGames Music Server running on port ${PORT}`
    );

});
